{
  "expo": {
    "name": "CoLearn",
    "slug": "colearn-app",
    "version": "1.5.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pillara.colearn",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "CoLearn needs microphone access for interactive voice conversations with Hermes."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.pillara.colearn",
      "versionCode": 2,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "minSdkVersion": 24,
      "buildToolsVersion": "35.0.0",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "CoLearn needs microphone access for voice conversations in CoLearn Compete and Hermes."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "gradleVersion": "8.10.2",
            "agpVersion": "8.7.0",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "buildToolsVersion": "35.0.0",
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "extraProguardRules": "-keep class org.webrtc.** { *; }\n-dontwarn org.webrtc.**\n-keep class com.oney.WebRTCModule.** { *; }\n-dontwarn com.oney.WebRTCModule.**\n-keep class com.zxcpoiu.incallmanager.** { *; }\n-dontwarn com.zxcpoiu.incallmanager.**"
          }
        }
      ],
      "./plugins/withAbiSplits"
    ],
    "scheme": "colearn",
    "extra": {
      "eas": {
        "projectId": "68ce27ad-b2d6-4dcf-913c-c669d9c47ef5"
      }
    }
  }
}
