rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // 1. HELPERS & GLOBAL SAFETY
    // ===============================================================
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // High-priority admin check (Level 3, 4, or 5)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "successugochukwuchi@gmail.com" || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('level', '1') in ["3", "4", "5"] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') == "successugochukwuchi@gmail.com"
        ))
      );
    }

    function isLevel5() {
      return isSignedIn() && (
        request.auth.token.email == "successugochukwuchi@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('level', '1') == "5")
      );
    }

    function isLevel4() {
      return isSignedIn() && (
        request.auth.token.email == "successugochukwuchi@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('level', '1') == "4")
      );
    }

    function isVendorOrAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "successugochukwuchi@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('level', '1') in ["3", "4", "5"] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') == "successugochukwuchi@gmail.com"
        ))
      );
    }

    function isLevel2() {
      return isSignedIn() && (
        request.auth.token.email == "successugochukwuchi@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('level', '1') in ["2", "3", "4", "5"])
      );
    }

    // ===============================================================
    // 2. ENTITY VALIDATORS
    // ===============================================================

    function isValidCourse(data) {
      return data.code is string && 
             data.title is string &&
             data.semester in ['1st', '2nd'];
    }

    function isValidNote(data) {
      return data.courseId is string &&
             data.title is string &&
             data.type in ['lecture', 'past_question', 'cbt'] &&
             data.authorId is string;
    }

    function isValidQuestionSheet(data) {
      return data.courseId is string &&
             data.semester in ['1st', '2nd'] &&
             data.year is string &&
             data.authorId is string;
    }

    function isValidQuestion(data) {
      return data.sheetId is string &&
             data.courseId is string &&
             data.text is string &&
             data.incorrectAnswers is list &&
             data.authorId is string;
    }

    function isValidTrack(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.category is string &&
             data.difficulty in ['Beginner', 'Intermediate', 'Advanced', 'Elite'] &&
             data.estimatedHours is number &&
             data.enrolledCount is number &&
             data.completedCount is number &&
             (data.get('steps', null) == null || data.steps is list);
    }

    function isValidEnrollment(data) {
      return data.userId == request.auth.uid &&
             data.trackId is string &&
             data.status in ['enrolled', 'completed'] &&
             data.progress is number &&
             data.enrolledAt is timestamp &&
             (data.status == 'enrolled' || (data.get('completedAt', null) != null && data.completedAt is timestamp));
    }

    // ===============================================================
    // 3. COLLECTIONS
    // ===============================================================

    function isValidUser(data) {
      return data.uid is string &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             data.email is string &&
             data.department is string &&
             data.level is string &&
             data.isActivated is bool &&
             (data.get('username_lower', null) == null || data.username_lower is string) &&
             (data.get('mobileNumber', null) == null || data.mobileNumber is string) &&
             (data.get('studentId', null) == null || data.studentId is string) &&
             (data.get('academicLevel', null) == null || data.academicLevel is string) &&
             (data.get('referralCount', null) == null || data.referralCount is number) &&
             (data.get('referredBy', null) == null || data.referredBy == null || data.referredBy is string) &&
             (data.get('theme', null) == null || data.theme is string) &&
             (data.get('photoURL', null) == null || data.photoURL is string) &&
             (data.get('currentSessionId', null) == null || data.currentSessionId is string) &&
             (data.get('createdAt', null) == null || data.createdAt is string);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && 
                      incoming().isActivated == (incoming().email == "successugochukwuchi@gmail.com");
      allow update: if isAdmin() || (
                      isOwner(userId) && (
                        (incoming().diff(existing()).affectedKeys().hasOnly(['username', 'username_lower', 'theme', 'referredBy', 'mobileNumber', 'photoURL', 'currentSessionId']) && isValidUser(incoming())) ||
                        (
                          incoming().diff(existing()).affectedKeys().hasOnly(['isActivated', 'activatedViaPromo', 'level', 'currentSessionId']) &&
                          existing().isActivated == false &&
                          incoming().isActivated == true &&
                          incoming().level in ['1', '2']
                        )
                      )
                    );
    }

    match /courses/{courseId} {
      allow read, list: if isSignedIn();
      allow create: if isAdmin() && isValidCourse(incoming());
      allow update: if isAdmin() && isValidCourse(incoming());
      allow delete: if isAdmin();
    }

    match /notes/{noteId} {
      allow read, list: if isSignedIn();
      allow create: if isAdmin() && isValidNote(incoming()) && incoming().authorId == request.auth.uid;
      allow update: if isAdmin() && isValidNote(incoming()) && (incoming().authorId == existing().authorId || incoming().authorId == request.auth.uid);
      allow delete: if isAdmin();
      
      match /videoQuestions/{questionId} {
        allow read, list: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /questionSheets/{sheetId} {
      allow read, list: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow read, list: if isSignedIn();
      allow create: if isAdmin() && isValidQuestion(incoming()) && incoming().authorId == request.auth.uid;
      allow update: if isAdmin() && isValidQuestion(incoming()) && (incoming().authorId == existing().authorId || incoming().authorId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /past_questions/{questionId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /system_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /activationCodes/{code} {
      allow get: if isSignedIn();
      allow list: if isVendorOrAdmin();
      allow create: if isAdmin();
      allow update: if isVendorOrAdmin() || (
        isSignedIn() && 
        existing().isUsed == false && 
        incoming().isUsed == true && 
        incoming().usedBy == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['isUsed', 'usedBy', 'usedAt', 'usedByStudentId'])
      );
      allow delete: if isAdmin() || (
        isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('level', '1') == "3" &&
        existing().get('assignedTo', '') == request.auth.uid
      );
    }

    match /verificationRequests/{requestId} {
      allow read, list: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /news/{newsId} { allow read, list: if isSignedIn(); allow write: if isAdmin(); }
    match /system/{docId} { 
      allow read, list: if true; 
      allow write: if isAdmin();
      
      // Allow update on stats by any signed-in user for registration/activation counts, and restrict promo updates
      allow update: if (docId == "stats" && isSignedIn()) || (
                     docId == "promo" && 
                     isSignedIn() && 
                     existing().isActive == true &&
                     incoming().count == existing().count + 1 &&
                     incoming().quota == existing().quota &&
                     incoming().isActive == (incoming().count < incoming().quota) &&
                     // Ensure only the expected fields are updated
                     incoming().diff(existing()).affectedKeys().hasOnly(['count', 'isActive'])
                    );
    }
    match /cbt_sessions/{sessionId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /discussions/{messageId} { 
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /notifications/{notificationId} { 
      allow read, list, update: if isSignedIn() && resource.data.userId == request.auth.uid; 
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /announcements/{announcementId} { allow read, list: if isSignedIn(); allow write: if isAdmin(); }
    match /reports/{reportId} { allow read, write: if isAdmin(); allow create: if isSignedIn(); }
    match /diagnostics/{docId} { allow read, write: if true; }

    // Chat rules
    match /chats/{chatId} {
      allow read, list: if isSignedIn() && (isAdmin() || request.auth.uid in resource.data.uids);
      allow create: if isSignedIn() && request.auth.uid in incoming().uids;
      allow update: if isSignedIn() && (isAdmin() || request.auth.uid in resource.data.uids);
      
      match /messages/{messageId} {
        allow read, list: if isSignedIn() && (isAdmin() || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.uids);
        allow create: if isSignedIn() && (isAdmin() || (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.uids && incoming().senderUid == request.auth.uid));
        allow delete: if isAdmin() || (isSignedIn() && resource.data.senderUid == request.auth.uid);
      }
    }

    match /friendships/{friendshipId} {
      allow read, list: if isSignedIn() && (isAdmin() || request.auth.uid in resource.data.uids);
      allow create: if isSignedIn() && request.auth.uid in incoming().uids;
      allow delete: if isSignedIn() && (isAdmin() || request.auth.uid in resource.data.uids);
    }

    match /friend_requests/{requestId} {
      allow read, list: if isSignedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() && incoming().fromUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /progress/{progressId} {
      allow read, list: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // FLUX Ecosystem
    match /flux_tracks/{trackId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if (isAdmin() || (isSignedIn() && isValidTrack(incoming()))) && (
        isAdmin() || 
        incoming().diff(existing()).affectedKeys().hasOnly(['enrolledCount', 'completedCount'])
      );
    }

    match /flux_enrollments/{enrollmentId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidEnrollment(incoming());
      allow update: if isSignedIn() && (isAdmin() || (resource.data.userId == request.auth.uid && isValidEnrollment(incoming()))) && (
        isAdmin() || 
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAt', 'progress'])
      );
      allow delete: if isAdmin();
    }

    match /timetables/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /recommended_timetables/{id} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /compete_matches/{matchId} {
      allow read, list, write: if isSignedIn();
    }

    match /disciplines/{disciplineId} {
      allow read, list: if isSignedIn();
      allow create: if isLevel5();
      allow delete: if isLevel5();
      allow update: if isLevel5() || (
        isLevel4() &&
        incoming().name == existing().name &&
        incoming().courses == existing().courses &&
        incoming().diff(existing()).affectedKeys().hasOnly(['departments'])
      );
    }

    match /universities/{uniId} {
      allow read, list: if true;
      allow create, update: if isLevel5() || isLevel4();
      allow delete: if isLevel5();
    }

    match /credentialSets/{credentialId} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isLevel5() || isLevel4();
    }

    match /priceHistory/{historyId} {
      allow read, list: if isLevel5() || isLevel4();
      allow create: if isLevel5();
      allow update, delete: if false;
    }

    match /seasons/{seasonId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();

      match /leaderboard/{userId} {
        allow read, list: if isSignedIn();
        allow write: if isSignedIn();
      }
    }
  }
}
